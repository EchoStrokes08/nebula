# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.

# --- Cliente (se incluyen en el bundle: solo valores públicos) ---
# URL y clave "anon" de tu proyecto Supabase (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo desarrollo: muestra la interfaz sin servidor, con una etiqueta visible de vista previa.
# No lo definas en builds distribuibles.
EXPO_PUBLIC_DEV_PREVIEW_UI=

# --- Servidor (secretos de Edge Functions; NUNCA con prefijo EXPO_PUBLIC_) ---
# Se configuran con `supabase secrets set`, no en este archivo del cliente:
#   SUPABASE_SERVICE_ROLE_KEY   (la inyecta Supabase en las funciones)
#   AI_PROVIDER, AI_API_KEY     (F10)

# --- Herramientas locales (migraciones) ---
# Cadena del pooler IPv4 (Project Settings → Database → Connection string → Session pooler).
# Contraseña codificada en URL (p. ej. "/" → "%2F"). Uso: npm run db:push
SUPABASE_DB_URL=
