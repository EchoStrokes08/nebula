{
  "expo": {
    "name": "Nebula",
    "slug": "nebula",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0815",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nebula.productividad",
      "versionCode": 24,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "backgroundColor": "#0B0815"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0815",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-quick-actions",
      [
        "expo-notifications",
        {
          "color": "#8055E8",
          "defaultChannel": "recordatorios",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nebula usa tus fotos solo para que elijas tu imagen de perfil.",
          "cameraPermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Nebula lee tu calendario para no planificar actividades encima de tus compromisos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nebula usa el micrófono solo mientras dictas una tarea, hábito o meta.",
          "speechRecognitionPermission": "Nebula convierte tu voz en texto para crear actividades. Siempre podrás revisar el resultado antes de guardar.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withGradleMemory",
      "./plugins/withFastBundle",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Hoy",
              "label": "Nebula · Hoy",
              "description": "Tus hábitos de hoy. Tócalos para marcarlos.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Orbita",
              "label": "Nebula · Órbita",
              "description": "Progreso del día, la semana y el mes de un vistazo.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Constancia",
              "label": "Nebula · Constancia",
              "description": "Mapa de tus últimas semanas: cuanto más cálido, más completo fue el día.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Enfoque",
              "label": "Nebula · Enfoque",
              "description": "Empieza un bloque de concentración con un toque.",
              "minWidth": "110dp",
              "minHeight": "80dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Accesos",
              "label": "Nebula · Accesos rápidos",
              "description": "Capturar, enfoque, planificar y diario.",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical"
            }
          ],
          "fonts": [
            "./node_modules/@expo-google-fonts/sora/700Bold/Sora_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "scheme": "nebula",
    "backgroundColor": "#0B0815",
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "android",
      "web"
    ]
  }
}
